CREATE TABLE users (
	id INTEGER NOT NULL, 
	email VARCHAR, 
	hashed_password VARCHAR, 
	full_name VARCHAR, 
	role VARCHAR, 
	grade_level INTEGER, 
	is_active BOOLEAN, 
	is_deleted BOOLEAN, 
	created_at DATETIME DEFAULT CURRENT_TIMESTAMP, 
	reset_token VARCHAR, 
	reset_token_expires DATETIME, 
